{
    "name": "@eliware/path",
    "type": "module",
    "version": "2.4.0",
    "description": "Import-meta-based path utilities for modern Node.js ESM applications.",
    "main": "src/index.mjs",
    "engines": {
        "node": ">=26"
    },
    "types": "index.d.ts",
    "files": [
        "src",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md",
        "examples"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./src/index.mjs"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "jest": {
        "collectCoverageFrom": [
            "src/current-path.mjs",
            "src/conversions.mjs"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/eliware/path"
    },
    "keywords": [
        "path",
        "paths",
        "esm",
        "jest",
        "utilities",
        "utils",
        "nodejs",
        "module",
        "resolver",
        "filepath",
        "import",
        "testing",
        "resolve",
        "relative",
        "file-url",
        "file-url-to-path",
        "import-meta"
    ],
    "author": "Eliware <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/path/issues"
    },
    "homepage": "https://github.com/eliware/path#readme",
    "devDependencies": {
        "@eliware/test": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "prettier": {
      "printWidth": 100,
      "tabWidth": 2,
      "useTabs": false,
      "semi": true,
      "singleQuote": false,
      "quoteProps": "as-needed",
      "jsxSingleQuote": false,
      "trailingComma": "all",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParens": "always",
      "proseWrap": "preserve",
      "endOfLine": "lf"
    },
    "eliware": {
      "apply": ["general", "library", "npm-published"]
    }
}
