{
  "name": "@eliware/path",
  "type": "module",
  "version": "1.1.4",
  "description": "An ESM/Jest friendly path utility.",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "scripts": {
    "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
    "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'",
    "lint": "npx oxlint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/path.git"
  },
  "keywords": [
    "path",
    "paths",
    "esm",
    "jest",
    "utilities",
    "utils",
    "nodejs",
    "module",
    "resolver",
    "filepath",
    "import",
    "testing"
  ],
  "author": "Eli Sterling <eli@eliware.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eliware/path/issues"
  },
  "homepage": "https://github.com/eliware/path#readme",
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)",
      "**/?(*.)+(spec|test).mjs"
    ]
  }
}
