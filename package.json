{
    "name": "@eliware/path",
    "type": "module",
    "version": "1.1.8",
    "description": "Import-meta-based path utilities for modern Node.js ESM applications.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "examples"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        }
    },
    "scripts": {
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
        "test:gaps": "npm test 2>&1 | node scripts/check-coverage.mjs",
        "lint": "npx oxlint .",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/path.git"
    },
    "keywords": [
        "path",
        "paths",
        "esm",
        "jest",
        "utilities",
        "utils",
        "nodejs",
        "module",
        "resolver",
        "filepath",
        "import",
        "testing",
        "resolve",
        "relative",
        "file-url",
        "file-url-to-path"
    ],
    "author": "Eli Sterling <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/path/issues"
    },
    "homepage": "https://github.com/eliware/path#readme",
    "devDependencies": {
        "jest": "^30.4.2",
        "typescript": "^7.0.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs"
        ]
    }
}
